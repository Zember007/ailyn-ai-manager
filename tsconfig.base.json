{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@ailyn/business-rules": ["packages/business-rules/src/index.ts"],
      "@ailyn/shared": ["packages/shared/src/index.ts"],
      "@ailyn/schemas": ["packages/schemas/src/index.ts"],
      "@ailyn/config": ["packages/config/src/index.ts"]
    }
  }
}
