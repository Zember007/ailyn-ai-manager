generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MessageAuthor {
  client
  manager
  system
  ai
}

enum MessageChannel {
  web_test
  wazzup
  admin
  whatsapp
  telegram
  system
}

enum ApplicationState {
  NEW
  COLLECTING_VEHICLE
  COLLECTING_VALUE
  COLLECTING_AMOUNT
  COLLECTING_RESIDENCE
  ELIGIBILITY_CHECK
  COLLECTING_DOCUMENTS
  COLLECTING_FAMILY_STATUS
  CHECKING_GUARANTOR
  SCHEDULING_VISIT
  TARGET_REACHED_DOCUMENTS
  TARGET_REACHED_VISIT
  REFUSED
  PAUSED
  EXISTING_CONTRACT_REDIRECT
}

enum ScenarioRunStatus {
  PASS
  FAIL
  BLOCKED
}

model Contact {
  id                 String         @id @default(uuid())
  externalContactId  String?
  fullName           String?
  phone              String?
  email              String?
  metadata           Json           @default("{}")
  conversations      Conversation[]
  applications       Application[]
  visits             Visit[]
  facts              ApplicationFact[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([phone])
  @@index([externalContactId])
}

model Conversation {
  id                     String        @id @default(uuid())
  contactId              String?
  channel                MessageChannel
  externalConversationId String?
  status                 String        @default("open")
  metadata               Json          @default("{}")
  contact                Contact?      @relation(fields: [contactId], references: [id])
  messages               Message[]
  applications           Application[]
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  @@index([contactId])
  @@index([channel, externalConversationId])
}

model Application {
  id             String           @id @default(uuid())
  contactId      String?
  conversationId String?
  state          ApplicationState @default(NEW)
  idempotencyKey String?          @unique
  metadata       Json             @default("{}")
  dialogueSummary String?         @db.Text
  dialogueSummaryRequestedAt DateTime?
  dialogueSummaryGeneratedAt DateTime?
  contact        Contact?         @relation(fields: [contactId], references: [id])
  conversation   Conversation?    @relation(fields: [conversationId], references: [id])
  facts          ApplicationFact[]
  factHistory    FactHistory[]
  reminders      Reminder[]
  notifications  ManagerNotification[]
  visits         Visit[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([contactId])
  @@index([conversationId])
  @@index([state])
}

model Message {
  id                String          @id @default(uuid())
  conversationId    String
  author            MessageAuthor
  channel           MessageChannel
  body              String
  externalMessageId String?
  sourceMessageId   String?
  idempotencyKey    String          @unique
  metadata          Json            @default("{}")
  conversation      Conversation    @relation(fields: [conversationId], references: [id])
  attachments       Attachment[]
  facts             ApplicationFact[] @relation("FactSourceMessage")
  auditEvents       AuditEvent[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([conversationId, createdAt])
  @@index([externalMessageId])
  @@index([sourceMessageId])
}

model Attachment {
  id                 String   @id @default(uuid())
  messageId          String?
  externalAttachmentId String?
  storageKey         String
  mimeType           String?
  byteSize           Int?
  checksum           String?
  metadata           Json     @default("{}")
  message            Message? @relation(fields: [messageId], references: [id])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([messageId])
}

model ApplicationFact {
  id              String     @id @default(uuid())
  applicationId   String?
  contactId       String?
  key             String
  value           Json
  previousValue   Json?
  source          String
  sourceMessageId String?
  supersededAt    DateTime?
  metadata        Json       @default("{}")
  application     Application? @relation(fields: [applicationId], references: [id])
  contact         Contact?   @relation(fields: [contactId], references: [id])
  sourceMessage   Message?   @relation("FactSourceMessage", fields: [sourceMessageId], references: [id])
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([applicationId, key])
  @@index([contactId, key])
  @@index([sourceMessageId])
}

model FactHistory {
  id            String      @id @default(uuid())
  applicationId String
  key           String
  previousValue Json?
  newValue      Json
  source        String
  application   Application @relation(fields: [applicationId], references: [id])
  createdAt     DateTime    @default(now())

  @@index([applicationId, key])
}

model Visit {
  id            String       @id @default(uuid())
  contactId     String?
  applicationId String?
  scheduledAt   DateTime?
  completedAt   DateTime?
  status        String       @default("planned")
  metadata      Json         @default("{}")
  contact       Contact?     @relation(fields: [contactId], references: [id])
  application   Application? @relation(fields: [applicationId], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([contactId])
  @@index([applicationId])
}

model ManagerNotification {
  id            String       @id @default(uuid())
  applicationId String?
  channel       String
  status        String       @default("pending")
  idempotencyKey String?     @unique
  payload       Json         @default("{}")
  sentAt        DateTime?
  application   Application? @relation(fields: [applicationId], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([applicationId])
  @@index([status])
}

model Reminder {
  id            String       @id @default(uuid())
  applicationId String?
  dueAt         DateTime
  status        String       @default("scheduled")
  idempotencyKey String?     @unique
  payload       Json         @default("{}")
  application   Application? @relation(fields: [applicationId], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([applicationId])
  @@index([dueAt, status])
}

model KnowledgeItem {
  id         String   @id @default(uuid())
  key        String   @unique
  category   String
  aliases    Json     @default("[]")
  answerRu   String
  answerKg   String?
  conditions Json     @default("{}")
  priority   Int      @default(0)
  status     String   @default("draft")
  version    Int      @default(1)
  active     Boolean  @default(true)
  source     String?
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  blocked   Boolean  @default(false)
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ScenarioRun {
  id        String            @id @default(uuid())
  status    ScenarioRunStatus
  summary   Json             @default("{}")
  results   ScenarioResult[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model ScenarioResult {
  id        String            @id @default(uuid())
  runId     String
  scenarioId String
  status    ScenarioRunStatus
  expected  String
  actual    String
  assertions Json             @default("[]")
  error     String?
  run       ScenarioRun       @relation(fields: [runId], references: [id])
  createdAt DateTime          @default(now())

  @@index([runId])
  @@index([scenarioId, status])
}

model AuditEvent {
  id              String   @id @default(uuid())
  actor           String
  action          String
  entityType      String
  entityId        String?
  messageId       String?
  idempotencyKey  String?  @unique
  metadata        Json     @default("{}")
  message         Message? @relation(fields: [messageId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([entityType, entityId])
  @@index([messageId])
}

model BackendLog {
  id             String   @id @default(uuid())
  level          String
  context        String
  message        String
  requestId      String?
  method         String?
  path           String?
  conversationId String?
  metadata       Json     @default("{}")
  stack          String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([level, createdAt])
  @@index([conversationId, createdAt])
}
