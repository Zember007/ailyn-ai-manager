{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "entryFile": "apps/api/src/main",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "src/ai/prompts/**/*",
        "outDir": "dist/apps/api/src/ai/prompts"
      }
    ]
  }
}
