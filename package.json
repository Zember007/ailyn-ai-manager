{
  "name": "ailyn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "documentation:generate": "node scripts/generate-documentation-chunks.mjs",
    "dev": "pnpm --parallel --filter @ailyn/api --filter @ailyn/admin dev",
    "lint": "eslint . --max-warnings=0",
    "pretest": "pnpm prisma:generate",
    "pretypecheck": "pnpm prisma:generate",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run --config vitest.config.ts",
    "test:scenarios": "vitest run --config tests/scenarios/vitest.config.ts",
    "prisma:generate": "pnpm --filter @ailyn/api prisma:generate",
    "prisma:migrate:deploy": "pnpm --filter @ailyn/api prisma:migrate:deploy"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.1",
    "@vitest/coverage-v8": "^4.0.14",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0",
    "vitest": "^4.0.14"
  }
}
